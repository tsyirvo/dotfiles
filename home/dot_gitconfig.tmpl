{{- $gitName := default "" (index . "gitName") -}}
{{- $gitEmail := default "" (index . "gitEmail") -}}
{{- if and (ne $gitName "") (ne $gitEmail "") }}
[user]
	name = {{ $gitName | quote }}
	email = {{ $gitEmail | quote }}

{{ end }}[core]
	excludesfile = ~/.gitignore_global
	editor = nano
	ignorecase = false
	# Global gitleaks hook. chezmoi owns the folder as exact_hooks,
	# so apply removes hooks that other tools write there (lefthook install).
	hooksPath = ~/.config/git/hooks

[credential]
{{ if .isDarwin }}  helper = osxkeychain
{{ end }}
[color]
	diff = auto
	status = auto
	branch = auto
	ui = true

[mergetool]
	keepBackup = false

[diff]
	tool = difftastic

[difftool]
	prompt = false

[difftool "difftastic"]
	cmd = difft --context 5 --skip-unchanged --display inline --background light "$LOCAL" "$REMOTE"

[pager]
	difftool = true

[push]
	default = simple
  followTags = true

# Clone/fetch GitHub over HTTPS (works before an SSH key exists), push over SSH
[url "git@github.com:"]
	pushInsteadOf = https://github.com/

[fetch]
	# Drop remote-tracking refs for branches deleted on the remote
	prune = true

[pull]
	rebase = false

[apply]
	whitespace = fix

[init]
  defaultBranch = main

[filter "lfs"]
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process

[rerere]
	enabled = true

[alias]
	upsync = "!f() { git pull origin \"$(git symbolic-ref --short HEAD)\" && git pull origin main; }; f"
	gone = "!f() { git fetch --prune || return; branches=$(git for-each-ref --format='%(if:equals=[gone])%(upstream:track)%(then)%(refname:short)%(end)' refs/heads | sed '/^$/d'); [ -n \"$branches\" ] || { printf 'No branches to delete.\\n'; return; }; printf 'Force-delete these local branches (including unmerged commits):\\n%s\\nType yes to confirm: ' \"$branches\"; IFS= read -r answer && [ \"$answer\" = yes ] || { printf 'Cancelled.\\n'; return; }; printf '%s\\n' \"$branches\" | while IFS= read -r branch; do git branch -D -- \"$branch\" || exit 1; done; }; f"

# Machine-local, unmanaged: signing keys, gpg/commit settings, anything that
# differs per box. Write there with `git config --file ~/.gitconfig.local …`
# — `git config --global` would edit this managed file and show in chezmoi diff.
# Must stay LAST so local values win.
[include]
	path = ~/.gitconfig.local
