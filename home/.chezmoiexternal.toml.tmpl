[".config/tmux/plugins/tpm"]
    type = "archive"
    url = "https://github.com/tmux-plugins/tpm/archive/master.tar.gz"
    exact = true
    stripComponents = 1
    refreshPeriod = "168h"

# App name -> glyph map for font-sketchybar-app-font. Follows the latest font release.
[".config/sketchybar/helpers/icon_map.lua"]
    type = "file"
    url = "https://github.com/kvndrsslr/sketchybar-app-font/releases/latest/download/icon_map.lua"
    refreshPeriod = "168h"
