#!/usr/bin/env bash
set -euo pipefail
# run_onchange_ — Node ABI is rendered into this script's BODY as a content key:
# when the ABI changes (node version switch), the rendered content changes and
# chezmoi re-runs this script, rebuilding native addons in the active global
# prefix. No manual step. NB: the key must stay in the body — the
# filename can't contain the `2>/dev/null` guard (slashes are illegal in names).
export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"
# ABI key: {{ output "node" "-p" "process.versions.modules" | trim | default "unknown" }}
if ! command -v node >/dev/null 2>&1; then
  echo "45-rebuild: node not installed yet — will run after mise install" >&2
  exit 0
fi
npm rebuild -g --depth=0 || true
