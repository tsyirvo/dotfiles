#!/usr/bin/env bash
set -euo pipefail
# run_once_after_ — gitleaks pre-commit hook (protect --staged).
export PATH="$HOME/.local/bin:$HOME/.local/share/mise/shims:/opt/homebrew/bin:/usr/local/bin:$PATH"
if ! command -v gitleaks >/dev/null 2>&1; then
  # Exit non-zero: a run_once_ script that exits 0 is recorded as done and never
  # re-runs, which would leave the hook missing for good. Failing retries next apply.
  echo "90-gitleaks: gitleaks not on PATH (10-install-packages / mise install failed?) — retrying next apply" >&2
  exit 1
fi
HOOKS_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/git/hooks"
mkdir -p "$HOOKS_DIR"
cat > "$HOOKS_DIR/pre-commit" <<'EOF'
#!/usr/bin/env bash
export PATH="$HOME/.local/bin:$HOME/.local/share/mise/shims:/opt/homebrew/bin:/usr/local/bin:$PATH"
gitleaks protect --staged --redact
EOF
chmod +x "$HOOKS_DIR/pre-commit"
# core.hooksPath lives in dot_gitconfig.tmpl — never `git config --global` here,
# it would rewrite the managed ~/.gitconfig and drift from chezmoi.
