#!/usr/bin/env bash
set -euo pipefail
# Re-runs on a node-pin change (ABI-relevant): the key must stay in the body —
# a filename can't carry a hash. NB: never exec node at render time here — it
# isn't installed on a fresh machine (use a content hash, not `node -p ...`).
export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"
# ABI key: {{ include "dot_config/mise/config.toml" | sha256sum }}
if ! command -v node >/dev/null 2>&1; then
  echo "45-rebuild: node not installed yet — will run after mise install" >&2
  exit 0
fi
# Skip npm/corepack themselves: rebuilding npm re-links bin/npm, which mise has
# replaced with a reshim wrapper → EEXIST. (mise `npm:` tools live in their own
# installs/npm-* prefixes, so they aren't in this list either.)
pkgs=()
while IFS= read -r p; do
  if [ -n "$p" ]; then pkgs+=("$p"); fi
done < <(npm ls -g --depth=0 --json 2>/dev/null | node -e '
  const d = JSON.parse(require("fs").readFileSync(0, "utf8") || "{}");
  for (const n of Object.keys(d.dependencies || {}))
    if (n !== "npm" && n !== "corepack") console.log(n);
')
if [ "${#pkgs[@]}" -eq 0 ]; then
  echo "45-rebuild: no global npm packages to rebuild" >&2
  exit 0
fi
npm rebuild -g "${pkgs[@]}" || true
