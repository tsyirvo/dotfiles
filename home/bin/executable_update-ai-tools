#!/usr/bin/env bash
#
# update-ai-tools — update every AI tool on this machine in one go.
#
#   brew casks    : claude, chatgpt, factory, tinybar (greedy: they self-update)
#   mise tools    : claude-code, codex, opencode, droid, herdr, rtk
#   herdr plugins : herdr plugin update
#   native CLIs   : claude (Claude Code), droid (Factory) — only when no
#                   package manager owns them
#   pi            : pi-update (mise executable, packages, then tstack's Pi harness sync)
#
# Tools that aren't installed are skipped with a note, so this is safe to run
# on any machine class (macbook / omarchy / devbox — brew only exists on mac).

set -euo pipefail

header() { printf '\n\033[1;34m==>\033[0m %s\n' "$*"; }
ok()     { printf '    \033[1;32m✓\033[0m %s\n' "$*"; }
skip()   { printf '    \033[2m-\033[0m skip: %s\n' "$*"; }

# brew_has <--formula|--cask> <name> — true if brew exists and the package is
# installed that way. Returns false when brew itself is missing (Linux boxes).
brew_has() {
    command -v brew >/dev/null 2>&1 || return 1
    brew list "$1" "$2" >/dev/null 2>&1
}

# mise_has <tool> — true if the global mise config installs the tool.
# -C "$HOME" ignores the pins of the project this runs from.
mise_has() {
    command -v mise >/dev/null 2>&1 || return 1
    mise -C "$HOME" where "$1" >/dev/null 2>&1
}

# upgrade_brew <name> — formula first, then cask; skips if not installed.
upgrade_brew() {
    local name="$1"
    if brew_has --formula "$name"; then
        header "Upgrading brew formula: $name"
        brew upgrade "$name"
        ok "$name up to date"
    elif brew_has --cask "$name"; then
        header "Upgrading brew cask: $name"
        # Without --greedy, brew skips casks that declare auto_updates.
        brew upgrade --cask --greedy "$name"
        ok "$name up to date"
    else
        skip "$name (not installed)"
    fi
}

# --- brew-managed tools -----------------------------------------------------
for pkg in claude chatgpt factory tinybar; do
    upgrade_brew "$pkg"
done

# --- mise-managed tools -----------------------------------------------------
# pi is mise-managed too, but pi-update upgrades it (below).
for tool in claude-code npm:@openai/codex npm:@opencode/cli npm:droid herdr rtk; do
    if mise_has "$tool"; then
        header "Upgrading mise tool: $tool"
        mise -C "$HOME" upgrade "$tool"
        ok "$tool up to date"
    else
        skip "$tool (not installed by mise)"
    fi
done

# --- herdr plugins (installed by .chezmoiscripts 22-install-herdr-plugins) ----
if command -v herdr >/dev/null 2>&1; then
    header "Updating herdr plugins"
    herdr plugin update --yes
    ok "herdr plugins up to date"
else
    skip "herdr plugins (herdr not installed)"
fi

# --- native self-updating CLIs ----------------------------------------------
# Claude Code and Droid install themselves to ~/.local/bin unless mise or
# Homebrew manages them. A self-update of a managed copy fights the manager.
if command -v claude >/dev/null 2>&1 && ! brew_has --cask claude-code && ! mise_has claude-code; then
    header "Updating Claude Code (native install)"
    claude update
    ok "claude up to date"
else
    skip "claude-code (no native install)"
fi

if command -v droid >/dev/null 2>&1 && ! brew_has --cask droid && ! mise_has npm:droid; then
    header "Updating Droid (native install)"
    droid update
    ok "droid up to date"
else
    skip "droid (no native install)"
fi

# --- pi (mise-managed) --------------------------------------------------------
if mise_has "npm:@earendil-works/pi-coding-agent"; then
    header "Updating pi and its packages"
    "$(dirname "$0")/pi-update"
    ok "pi up to date"
else
    skip "pi (not installed as a mise npm tool)"
fi

printf '\n All AI tools up to date 🎉\n'
