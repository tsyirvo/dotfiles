{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "WebSearch",
      "WebFetch",
      "Bash(lsof *)",
      "Bash(mkdir *)",
      "Bash(touch *)",
      "Bash(rtk *)",
      "Bash(mise *)",
      "Bash(gh *)",
      "Bash(docker *)",
      "Bash(claude mcp list *)",
      "Bash(claude mcp get *)",
      "Bash(npx @biomejs/biome *)",
      "Bash(npx biome *)",
      "Bash(npx eslint *)",
      "Bash(npx prettier *)",
      "Bash(npx vitest *)",
      "Bash(npx jest *)",
      "Bash(npx tsc *)",
      "Bash(npx tsc-files *)",
      "Bash(npx turbo *)",
      "Bash(npx expo *)",
      "Bash(coderabbit *)",
      "mcp__ide__*",
      "mcp__pencil__*",
      "mcp__sentry__get_issue_details",
      "mcp__sentry__search_events",
      "mcp__sentry__search_issues",
      "mcp__sentry__find_organizations",
      "mcp__sentry__search_issue_events",
      "mcp__convex__status",
      "mcp__convex__data",
      "mcp__convex__tables"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(.dev.vars)",
      "Read(.dev.vars.*)",
      "Read(!*.example)",
      "Edit(.env)",
      "Edit(.env.*)",
      "Edit(.dev.vars)",
      "Edit(.dev.vars.*)",
      "Edit(!*.example)",
      "Edit(package-lock.json)",
      "Edit(pnpm-lock.yaml)",
      "Edit(yarn.lock)",
      "Edit(bun.lock)",
      "Bash(gh repo delete *)",
      "Bash(gh repo archive *)",
      "Bash(gh repo rename *)",
      "Bash(gh repo edit *--visibility*)",
      "Bash(gh run delete *)",
      "Bash(gh cache delete *)",
      "Bash(gh secret *)",
      "Bash(gh project delete *)",
      "Bash(gh ssh-key delete *)",
      "Bash(gh gpg-key delete *)",
      "Bash(gh auth *)",
      "Bash(gh api *)"
    ],
    "defaultMode": "auto"
  },
  "autoMode": {
    "environment": [
      "$defaults",
      "Organization: personal developer machine (macOS). Primary use: software development (TypeScript, React Native / Expo, web)",
      "Source control: github.com/tsyirvo and all repos under it",
      "Key services: Sentry, Convex"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/herdr-agent-state.sh\" session",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh -c 'rex __internal session-start --agent claude 2>/dev/null || true'",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "$HOME/.claude/statusline.sh",
    "padding": 0,
    "refreshInterval": 30
  },
  "enabledPlugins": {
    "claude-code-wakatime@wakatime": true,
    "claude-md-management@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true
  },
  "model": "opus",
  "fallbackModel": ["sonnet", "haiku"],
  "effortLevel": "medium",
  "modelSettings": {
    "claude-fable-5-1": {
      "effortLevel": "high"
    },
    "claude-opus-5-5": {
      "effortLevel": "medium"
    },
    "claude-sonnet-5-5": {
      "effortLevel": "medium"
    }
  },
  "autoCompactWindow": 400000,
  "promptCacheTtl": "1h",
  "disableClaudeAiConnectors": true,
  "tui": "fullscreen",
  "remoteControlAtStartup": false,
  "agentPushNotifEnabled": false,
  "skipAutoPermissionPrompt": true
}
