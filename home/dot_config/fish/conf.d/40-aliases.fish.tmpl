### Git ###
alias glog="git log --graph --pretty=format:'%Cred%h%Creset %an: %s - %Creset %C(yellow)%d%Creset %Cgreen(%cr)%Creset' --abbrev-commit --date=relative"
alias gd='git difftool'
alias ga='git add -A'
alias gac='git add -A && git commit -m'
alias gs='git status -sb'

alias gcp="git checkout -"
alias gcm="git checkout main"

alias gsc='git stash && git stash clear'

alias gp='git push -u origin HEAD'
alias gpf='git push origin HEAD --force-with-lease --force-if-includes'

alias ghpr="gh pr create --title"

### System ###
alias ls="eza --color=always --long --git --icons=always --no-time --no-user"
alias lst="eza --color=always --long --git --icons=always --no-time --no-user --tree --level=2 --ignore-glob=\"node_modules|.git\""
alias fz="fzf --preview=\"bat --color=always {}\" | xargs -r cursor"

### Tailscale ###
alias tssh="tailscale ssh"

### Claude ###
alias cc="claude"

### Chezmoi ###
alias cm="chezmoi"

### Xcode ###
alias ios="open -b com.apple.dt.Devices"

### Tmux ###
alias t="tmux"
alias ta="tmux a -t"
alias tls="tmux ls"
alias tn="tmux new -s"

### Worktrunk ###
alias wls='wt list --full'
alias wrm='wt remove'

{{- if .isDevbox }}
# Debian ships batcat/fdfind; ~/.local/bin/{bat,fd} symlinks restore the names.
alias cat="bat"
{{- end }}
