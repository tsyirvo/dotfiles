{{- /* chezmoi:modify-template */ -}}
{{- $settings := default "{}" .chezmoi.stdin | fromJson -}}
{{- $migrations := concat (get $settings "migrations" | default (list)) .hex.settings.migrations | uniq -}}
{{- range $key, $value := .hex.settings -}}
{{-   $settings = setValueAtPath $key $value $settings -}}
{{- end -}}
{{ $settings | setValueAtPath "migrations" $migrations | toPrettyJson }}
